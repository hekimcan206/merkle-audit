{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Log": {
    "MaxGroupCommit": 1000,
    "QueueCapacity": 10000,
    "MaxBatch": 1000,
    "PublishInterval": "00:00:10",
    "MaxHeadAge": "01:00:00",
    "AppendApiKeys": []
  },
  "Signing": {
    "KeyFile": "",
    "RetiredPublicKeyFiles": []
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
