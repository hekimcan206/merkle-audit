# Development-only values. docker compose reads .env if present; every variable has a safe local default.
POSTGRES_PASSWORD=postgres-dev-only
MIGRATOR_PASSWORD=migrator-dev-only
APP_PASSWORD=app-dev-only
READER_PASSWORD=reader-dev-only
APPEND_API_KEY=append-dev-only
POSTGRES_PORT=58732
SERVER_PORT=58780
# Point at an OTLP collector (e.g. http://aspire-dashboard:18889 with --profile observability) to export traces/metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=
